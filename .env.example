# =============================================================================
# Batte — configuration locale. Copier en `.env` et adapter.
# Aucune valeur metier ici : les seuils, taux et coefficients vivent dans la
# table `parametre` (CLAUDE.md §7). Ce fichier ne contient que de la plomberie
# et des secrets.
# =============================================================================

# --- Serveur -----------------------------------------------------------------
# Port de l'API. Le front en dev tourne sur 5173 et proxifie /api vers ce port.
PORT=3001
# En production, l'API sert aussi le bundle React : une seule commande, un seul port.
NODE_ENV=development

# --- Base de donnees ---------------------------------------------------------
# Fichier SQLite unique. Sauvegardable par simple copie.
CHEMIN_BASE=./donnees/batte.sqlite
# Sauvegarde horodatee au demarrage, au plus UNE PAR JOUR CIVIL BELGE (01-SPEC,
# exigences non fonctionnelles ; voir packages/db/src/sauvegarde.ts). Pointer
# ce dossier vers une cle USB ou un disque reseau protege d'une panne du disque
# qui porte aussi la base (docs/17-VINGT-AMELIORATIONS.md fiche 19) : un chemin
# ABSOLU ici sort la sauvegarde du disque de l'original.
DOSSIER_SAUVEGARDES=./sauvegardes
# Retention des sauvegardes, en jours.
RETENTION_SAUVEGARDES_JOURS=30
# Plancher : nombre de sauvegardes les plus RECENTES jamais purgees, quel que
# soit leur age. Protege contre une horloge faussee ou une machine restee
# eteinte plus longtemps que la retention ci-dessus (docs/17 fiche 19).
RETENTION_SAUVEGARDES_MINIMUM=10

# --- Documents generes -------------------------------------------------------
DOSSIER_SORTIES=./sorties

# --- API Claude (optionnelle : l'application fonctionne integralement sans) ---
# CLAUDE.md §5 : la cle ne doit JAMAIS atteindre le navigateur.
# Laisser vide desactive proprement l'assistance : tous les ecrans continuent
# de fonctionner et annoncent « commentaire indisponible ».
ANTHROPIC_API_KEY=
#
# Le plafond de depense mensuel N'EST PAS ici : c'est une valeur metier, donc
# elle vit dans la table `parametre`, cle `plafond_ia_mensuel_cents`, modifiable
# depuis l'ecran Parametres (CLAUDE.md §7). Une variable d'environnement
# homonyme a existe dans ce fichier sans etre lue par le code : elle donnait
# l'illusion d'un plafond configure alors qu'il ne l'etait pas.

# --- Distance routière des lieux (optionnelle : l'application fonctionne integralement sans) ---
# CLAUDE.md §5 / D-064 (30/07/2026) : calcule automatiquement, une fois par
# lieu, la distance routiere aller simple stockee dans `lieu_marche.distance_km`,
# a la creation ou a la modification d'un lieu — jamais a la lecture. Service
# OpenRouteService (geocodage + itineraires), palier gratuit verifie le
# 30/07/2026 : 2 500 requetes/jour, 40 000/mois. Inscription (gratuite) :
# https://openrouteservice.org/dev/#/signup
# Laisser vide desactive proprement le calcul automatique : la saisie manuelle
# de la distance reste disponible, exactement comme pour ANTHROPIC_API_KEY.
OPENROUTESERVICE_API_KEY=

# --- Mail (bons de commande fournisseurs) ------------------------------------
# Mot de passe d'application, jamais le mot de passe du compte.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=
# `true` : les mails sont ecrits dans DOSSIER_SORTIES au lieu d'etre envoyes.
MAIL_MODE_TEST=true

# --- Meteo -------------------------------------------------------------------
# Open-Meteo ne demande aucune cle : il n'y a donc rien a configurer ici.
# L'URL du service est fixee dans apps/api/src/meteo/open-meteo.ts ; une
# variable OPEN_METEO_URL a figure dans ce fichier sans jamais etre lue.
#
# Regle de tenue de ce fichier : il decrit EXACTEMENT les variables que le code
# lit, ni plus ni moins. Une variable documentee mais ignoree est pire qu'une
# variable absente — elle fait croire a un reglage qui n'existe pas. Le test
# apps/api/src/securite-secrets.test.ts fige cette regle dans les deux sens.
