/**
 * Schema Drizzle. Conventions de docs/02-MODELE-DONNEES.md :
 *   - tables `snake_case` au singulier
 *   - cle primaire `id` en texte (UUID v7, donc triable chronologiquement)
 *   - `cree_le` / `modifie_le` en ISO 8601 UTC
 *   - argent en centimes, masses en grammes, volumes en millilitres, taux en
 *     points de base — tous en INTEGER, jamais de flottant (invariant n°8)
 *
 * Les tables arrivent lot par lot, pour que chaque migration reste relisible.
 */

import { relations } from 'drizzle-orm';
import { index, integer, real, sqliteTable, text, uniqueIndex } from 'drizzle-orm/sqlite-core';

/* ═══════════════════════════════════════════════════════════════════════════
   LOT 0 — Socle
   ═══════════════════════════════════════════════════════════════════════════ */

/**
 * Toute valeur metier configurable. C'est la table qui rend possible le « zero
 * code en dur » : seuils legaux, taux, coefficients du moteur de prevision,
 * capacites materielles.
 *
 * Une cle peut avoir plusieurs lignes successives avec des dates de validite
 * differentes : on garde l'historique des seuils annee par annee au lieu
 * d'ecraser, sinon un recalcul sur un exercice passe utiliserait le seuil
 * de cette annee-ci.
 */
export const parametre = sqliteTable(
  'parametre',
  {
    id: text('id').primaryKey(),
    cle: text('cle').notNull(),
    valeur: text('valeur').notNull(),
    typeValeur: text('type_valeur', {
      enum: ['entier', 'decimal', 'texte', 'booleen', 'json'],
    }).notNull(),
    dateDebutValidite: text('date_debut_validite').notNull(),
    /** `null` = en vigueur sans terme connu. */
    dateFinValidite: text('date_fin_validite'),
    source: text('source').notNull(),
    description: text('description').notNull(),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    // Deux lignes pour la meme cle sont permises, mais pas deux fois la meme
    // cle sur la meme date de debut : ce serait une ambiguite de resolution.
    uniqueIndex('idx_parametre_cle_debut').on(table.cle, table.dateDebutValidite),
    index('idx_parametre_cle').on(table.cle),
  ],
);

/**
 * Pas d'authentification en V1 : application locale, deux personnes
 * (docs/02-MODELE-DONNEES.md). Le champ sert uniquement a tracer qui a saisi
 * quoi dans le journal d'audit et sur les mouvements de stock.
 */
export const utilisateur = sqliteTable('utilisateur', {
  id: text('id').primaryKey(),
  nom: text('nom').notNull(),
  role: text('role', { enum: ['proprietaire', 'collaborateur'] }).notNull(),
  actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
  creeLe: text('cree_le').notNull(),
  modifieLe: text('modifie_le').notNull(),
});

/**
 * Journal d'audit. CLAUDE.md §7 : « rien ne s'efface ».
 *
 * Restreint aux DONNEES DE REFERENCE (docs/07 §5.2). Journaliser du
 * transactionnel serait un cout pur : les mouvements de stock et les lignes de
 * vente sont immuables par construction, donc il n'y a rien a journaliser
 * dessus. On journalise ce qui peut changer : recettes, parametres,
 * ingredients, produits, conditionnements, lieux.
 */
export const journalAudit = sqliteTable(
  'journal_audit',
  {
    id: text('id').primaryKey(),
    tableCible: text('table_cible').notNull(),
    enregistrementId: text('enregistrement_id').notNull(),
    action: text('action', { enum: ['creation', 'modification', 'annulation'] }).notNull(),
    valeursAvant: text('valeurs_avant', { mode: 'json' }),
    valeursApres: text('valeurs_apres', { mode: 'json' }),
    dateAction: text('date_action').notNull(),
    utilisateur: text('utilisateur'),
  },
  (table) => [
    index('idx_audit_cible').on(table.tableCible, table.enregistrementId),
    /**
     * `enregistrement_id` SEUL, en plus de l'index compose ci-dessus.
     *
     * Ce n'est pas une redondance : un index compose ne sert une requete que si
     * sa colonne la PLUS A GAUCHE est filtree. Or l'application filtre sur le
     * seul `enregistrement_id` (« tout l'historique de CETTE ligne »), sans
     * connaitre ni preciser la table cible — `idx_audit_cible` est alors
     * inutilisable et SQLite parcourt tout.
     *
     * Trouve par l'audit des colonnes orphelines du 30/07/2026, sur la table qui
     * grossit le plus vite de l'application.
     */
    index('idx_audit_enregistrement').on(table.enregistrementId),
    index('idx_audit_date').on(table.dateAction),
  ],
);

/* ═══════════════════════════════════════════════════════════════════════════
   LOT 1 — Referentiel : fournisseurs, ingredients, recettes, produits
   ═══════════════════════════════════════════════════════════════════════════ */

export const fournisseur = sqliteTable(
  'fournisseur',
  {
    id: text('id').primaryKey(),
    nom: text('nom').notNull(),
    /**
     * `systeme` n'est pas un fournisseur : c'est une contrepartie interne, dont
     * le seul cas est « Inventaire d'ouverture ». On ne lui commande RIEN — le
     * moteur de reapprovisionnement l'ecarte explicitement (D-049). Non
     * saisissable depuis un formulaire : `schemaSaisieFournisseur` n'accepte
     * que les quatre types commerciaux.
     */
    type: text('type', {
      enum: ['moulin', 'grossiste', 'ferme', 'detail', 'systeme'],
    }).notNull(),
    email: text('email'),
    telephone: text('telephone'),
    adresse: text('adresse'),
    /** Alimente le point de commande : conso moyenne x delai + stock de securite. */
    delaiLivraisonJours: integer('delai_livraison_jours').notNull().default(0),
    francoDePortCents: integer('franco_de_port_cents'),
    commandeMinimumCents: integer('commande_minimum_cents'),
    /**
     * On BLOQUE, on ne supprime jamais (docs/07 §1.1) : une reception de 2026
     * reference ce fournisseur, et le droit comptable belge impose de pouvoir
     * la relire pendant dix ans.
     */
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [index('idx_fournisseur_actif').on(table.actif)],
);

export const ingredient = sqliteTable(
  'ingredient',
  {
    id: text('id').primaryKey(),
    nom: text('nom').notNull(),
    /**
     * `boisson` ajoutee le 31/07/2026 (fiche 15 §4.1, `[A TRANCHER]` tranche par
     * le porteur) : cafe moulu, chicoree, cannelle et eau n'avaient aucun
     * classement honnete — ni garniture, ni consommable (un consommable, c'est
     * le gobelet). La machinerie du cafe existait deja entierement cote
     * nomenclature de vente ; seule la categorie manquait, donc la liste
     * d'ingredients du porteur etait inseralable.
     *
     * AUCUNE migration : cette liste n'est contrainte qu'en TypeScript, pas par
     * un `CHECK` SQL (verifie sur `drizzle/*.sql`). Ajouter une valeur ne touche
     * donc pas la base existante.
     */
    categorie: text('categorie', {
      enum: [
        'farine',
        'laitier',
        'oeuf',
        'sucre',
        'garniture',
        'consommable',
        'gaz',
        'boisson',
        'aromate',
      ],
    }).notNull(),
    // (voir `produitVente.consommationUnite` pour la refonte du 31/07/2026)
    uniteReference: text('unite_reference', { enum: ['g', 'ml', 'piece'] }).notNull(),
    /**
     * Densite en g/ml. REEL et non entier : c'est un coefficient physique
     * d'entree, pas un montant stocke — l'invariant n°8 ne porte que sur les
     * montants, et le resultat de toute conversion est arrondi a l'entier.
     * `null` tant qu'aucune conversion masse<->volume n'est necessaire ;
     * `convertir()` leve alors explicitement plutot que de supposer 1 g/ml.
     */
    densiteGParMl: real('densite_g_par_ml'),
    /** Sous-ensemble de la liste reglementaire des 14 allergenes. */
    allergenes: text('allergenes', { mode: 'json' }).$type<string[]>().notNull().default([]),
    /**
     * Distingue « verifie, aucun allergene » de « jamais evalue ».
     *
     * Sans ce drapeau, `allergenes = []` est ambigu : un ingredient qu'on n'a
     * jamais interroge s'imprime exactement comme un ingredient controle sans
     * allergene. Sur une affichette remise au client, cette ambiguite se lit
     * « aucun allergene » — une affirmation qu'on n'est pas en mesure de faire,
     * et le seul defaut de ce fichier qui puisse envoyer quelqu'un a l'hopital.
     *
     * C'est la doctrine « une valeur inconnue ne vaut pas zero » appliquee a la
     * securite alimentaire : tant que ce drapeau est faux, le document doit
     * ecrire « allergenes non encore verifies », jamais une liste vide.
     */
    allergenesVerifies: integer('allergenes_verifies', { mode: 'boolean' })
      .notNull()
      .default(false),
    stockSecurite: integer('stock_securite').notNull().default(0),
    delaiLivraisonJours: integer('delai_livraison_jours'),
    dureeConservationJours: integer('duree_conservation_jours'),
    /**
     * PAS de `cump_cents_par_unite` ici, contrairement a docs/02.
     *
     * Une valeur derivee stockee contredit la regle n°5 (« le stock ne se
     * modifie que par un mouvement ») appliquee a la valeur au lieu de la
     * quantite — c'est le defaut releve en docs/07 §6.2. Le CUMP sera une VUE
     * calculee a partir des lots, introduite au Lot 2. En attendant, le cout de
     * reference vient du conditionnement (D-018).
     */
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    uniqueIndex('idx_ingredient_nom').on(table.nom),
    index('idx_ingredient_actif').on(table.actif),
  ],
);

/**
 * Un format d'achat chez un fournisseur donne : « sac 25 kg », « plaque 30 oeufs ».
 *
 * C'est ce qui permet d'arrondir une commande a un conditionnement reel — on ne
 * commande pas 17 kg quand le sac fait 25 kg (docs/01 module 2).
 */
export const conditionnement = sqliteTable(
  'conditionnement',
  {
    id: text('id').primaryKey(),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    fournisseurId: text('fournisseur_id')
      .notNull()
      .references(() => fournisseur.id),
    libelle: text('libelle').notNull(),
    /** Quantite contenue, dans l'unite de reference de l'ingredient. */
    quantiteUniteRef: integer('quantite_unite_ref').notNull(),
    prixCents: integer('prix_cents').notNull(),
    referenceFournisseur: text('reference_fournisseur'),
    /**
     * Date du prix. Une nouvelle ligne est creee a chaque changement de prix
     * plutot que d'ecraser : sans historique, aucune tendance ni ecart de prix
     * n'est calculable (docs/07 §6.8 rang 17).
     */
    datePrix: text('date_prix').notNull(),
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    index('idx_conditionnement_ingredient').on(table.ingredientId, table.actif),
    index('idx_conditionnement_fournisseur').on(table.fournisseurId),
    // Le prix unitaire se DEDUIT toujours de prix_cents / quantite_unite_ref.
    // Ne jamais le stocker separement (invariant de docs/02).
    index('idx_conditionnement_prix').on(table.ingredientId, table.datePrix),
  ],
);

/**
 * Une VERSION de recette. Une recette active est immuable : toute modification
 * cree une version `version + 1` et archive la precedente (decision D-005).
 *
 * Les productions referencent une `recette_id` precise, donc une version
 * precise — sans quoi tout recalcul historique de cout serait faux.
 */
export const recette = sqliteTable(
  'recette',
  {
    id: text('id').primaryKey(),
    code: text('code').notNull(),
    nom: text('nom').notNull(),
    version: integer('version').notNull().default(1),
    recetteParentId: text('recette_parent_id'),
    statut: text('statut', { enum: ['brouillon', 'active', 'archivee'] })
      .notNull()
      .default('brouillon'),
    typePate: text('type_pate').notNull(),
    sansGluten: integer('sans_gluten', { mode: 'boolean' }).notNull().default(false),
    /** Rendement de reference : volume et nombre de crepes d'une fournee type. */
    rendementReferenceMl: integer('rendement_reference_ml').notNull(),
    rendementReferenceCrepes: integer('rendement_reference_crepes').notNull(),
    /**
     * Pertes en points de base. Deux termes distincts qui s'appliquent en
     * cascade, pas en somme. `perte_fixe_ml` porte le terme FIXE par fournee
     * (fond de bassine, premiere crepe sacrifiee) : docs/07 §1.8 rappelle que
     * `Intrant = Sortie x (1 + perte%) + perte_fixe` — un seul des deux termes
     * ne modelise pas une pate a crepes.
     */
    perteCuissonBp: integer('perte_cuisson_bp').notNull().default(0),
    tauxCasseBp: integer('taux_casse_bp').notNull().default(0),
    perteFixeMl: integer('perte_fixe_ml').notNull().default(0),
    procede: text('procede'),
    dateActivation: text('date_activation'),
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    uniqueIndex('idx_recette_code_version').on(table.code, table.version),
    index('idx_recette_statut').on(table.statut),
  ],
);

export const recetteLigne = sqliteTable(
  'recette_ligne',
  {
    id: text('id').primaryKey(),
    recetteId: text('recette_id')
      .notNull()
      .references(() => recette.id),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    /** Quantite pour le rendement de reference, dans l'unite de l'ingredient. */
    quantiteUniteRef: integer('quantite_unite_ref').notNull(),
    ordre: integer('ordre').notNull().default(0),
    noteTechnique: text('note_technique'),
  },
  (table) => [
    uniqueIndex('idx_recette_ligne_unique').on(table.recetteId, table.ingredientId),
    index('idx_recette_ligne_recette').on(table.recetteId, table.ordre),
  ],
);

/**
 * Ce qui se vend au stand.
 *
 * La distinction transforme / revendu est STRUCTURANTE (docs/02) : un produit
 * transforme consomme un lot de pate et des garnitures, un produit revendu sort
 * directement une unite de stock. Marges, mecaniques de stock et regimes AFSCA
 * different. Et surtout : a marge egale, la revente genere ~2,6 fois plus de
 * chiffre d'affaires — or les seuils legaux portent sur le CA.
 */
export const produitVente = sqliteTable(
  'produit_vente',
  {
    id: text('id').primaryKey(),
    nom: text('nom').notNull(),
    /**
     * `menu` (fiche 16) : un produit fait d'AUTRES produits, dont le cout vient
     * de ses composants et non d'une recette propre.
     *
     * Sans cette valeur, un menu devait etre cree comme un produit ordinaire —
     * donc avec une fausse recette, dont le cout de revient standard aurait ete
     * TROMPEUR a cote du vrai cout calcule depuis les composants.
     */
    nature: text('nature', { enum: ['transforme', 'revendu', 'menu'] }).notNull(),
    /** Requis si `transforme`, null si `revendu`. */
    recetteId: text('recette_id').references(() => recette.id),
    /** Requis si `revendu` (l'article achete-revendu), null si `transforme`. */
    ingredientId: text('ingredient_id').references(() => ingredient.id),
    prixCents: integer('prix_cents').notNull(),
    /**
     * Ce qu'UNE unite vendue consomme DE LA PRODUCTION. Trois reponses
     * possibles, et elles s'excluent — d'ou un champ qui les NOMME, plutot que
     * deux champs et une deduction (31/07/2026, tranche par le porteur) :
     *
     *  - `crepes`        : N crepes, avec `nb_crepes >= 1`.
     *  - `volume_pate`   : V millilitres de pate vendue telle quelle, avec
     *                      `volume_ml_par_unite` renseigne (fiche 15 §5.1).
     *  - `nomenclature`  : RIEN de la production. Sa composition vit dans
     *                      `produit_vente_composant` — le cafe fait a la tasse
     *                      (fiche 15 §4), qui ne se produit pas par fournee.
     *
     * LE DEFAUT QUE CE CHAMP CORRIGE : `nb_crepes = 0` portait DEUX sens a la
     * fois — « c'est de la pate, pas une crepe » et « ce produit ne consomme
     * aucune crepe ». La validation ne pouvait pas les distinguer, donc elle
     * reclamait un volume de pate pour un cafe. Y repondre aurait fait
     * retrancher 100 ml du bac de pate a chaque cafe vendu : pire que le
     * blocage.
     *
     * NULL pour `revendu` et `menu` : la question ne se pose pas, un revendu ne
     * consomme rien de la production. `null` = « sans objet », jamais « zero ».
     */
    consommationUnite: text('consommation_unite', {
      enum: ['crepes', 'volume_pate', 'nomenclature'],
    }),
    /** Nombre de crepes consommees par unite vendue. Null si `revendu`. */
    nbCrepes: integer('nb_crepes').default(1),
    /**
     * Volume de pate que represente UNE unite vendue, en ml (fiche 15 §5.1).
     *
     * Pertinent uniquement pour la PATE VENDUE TELLE QUELLE : un produit
     * `transforme`, rattache a une recette, dont `nb_crepes = 0` — zero est ici
     * une valeur EXPLICITE (« cette unite ne produit aucune crepe »), pas une
     * absence.
     *
     * Sans cette colonne, la cloture au volume compterait une bouteille vendue
     * comme des CREPES PRODUITES : deux litres partis en bouteille quittent le
     * bac sans jamais passer sur la plaque. Mesure : 4 200 ml disparus dont
     * 2 000 vendus donnent 29 crepes, contre 55 sans la retenue.
     */
    volumeMlParUnite: integer('volume_ml_par_unite'),
    categorie: text('categorie'),
    /**
     * Consommation sur place. Alimente le compteur du seuil SCE / caisse
     * blanche, distinct du seuil de franchise TVA (docs/07 §6.7). La vente a
     * emporter n'est PAS un service de restauration : ce drapeau reste faux
     * tant qu'il n'y a ni table ni chaise au stand.
     */
    consommationSurPlace: integer('consommation_sur_place', { mode: 'boolean' })
      .notNull()
      .default(false),
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    index('idx_produit_nature').on(table.nature, table.actif),
    index('idx_produit_recette').on(table.recetteId),
  ],
);

/**
 * NOMENCLATURE DE VENTE : ce qu'un produit consomme au moment ou il est VENDU,
 * par opposition a la recette, consommee au moment de la PRODUCTION.
 *
 * C'est la distinction structurante du catalogue elargi (fiche 15) : les
 * produits ne different pas par ce qu'ils sont, mais par le MOMENT ou ils
 * consomment du stock.
 *
 * | Nature                  | Exemple          | Consomme               | Quand         |
 * | ----------------------- | ---------------- | ---------------------- | ------------- |
 * | Transforme par lot      | crepe            | farine, lait, oeufs    | production    |
 * | Transforme a la demande | cafe a la tasse  | cafe, eau, gobelet     | **vente**     |
 * | Consommable             | serviette        | l'article              | **vente**     |
 * | Revendu                 | sirop preemballe | l'article              | **vente**     |
 *
 * Un seul concept resout quatre demandes du porteur : le cafe (qui n'a pas de
 * lot de production, il se fait a la tasse), les serviettes et gobelets (dont
 * la categorie `consommable` existait sans que RIEN ne les fasse sortir du
 * stock — meme defaut que les garnitures, D-053), les contenants, et les
 * menus (fiche 16), qui n'en sont qu'un cas particulier.
 *
 * `consommationSurPlace` NULL = consomme dans les deux cas. `true`/`false` =
 * seulement sur place / seulement a emporter : une assiette n'est utilisee que
 * sur place, un contenant que pour l'emporte.
 *
 * ATTENTION AUX PETITES QUANTITES : la quantite est un ENTIER (regle n°4). Une
 * pincee de cannelle a 0,2 g par tasse s'arrondirait a 0 et disparaitrait sans
 * bruit. On saisit donc pour un LOT DE REFERENCE — « pour 100 cafes : 20 g » —
 * exactement comme R1 est ecrite « pour 6 crepes : 145 g de farine ».
 */
export const produitVenteComposant = sqliteTable(
  'produit_vente_composant',
  {
    id: text('id').primaryKey(),
    produitVenteId: text('produit_vente_id')
      .notNull()
      .references(() => produitVente.id),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    /** Quantite consommee pour `quantiteReferenceUnites` unites vendues. */
    quantiteUniteRef: integer('quantite_unite_ref').notNull(),
    /** Lot de reference. 1 pour un gobelet, 100 pour une pincee de cannelle. */
    quantiteReferenceUnites: integer('quantite_reference_unites').notNull().default(1),
    /** NULL = consomme quel que soit le mode de consommation. */
    consommationSurPlace: integer('consommation_sur_place', { mode: 'boolean' }),
    /**
     * `true` = OPTION, servie seulement si le client la demande (creme dans un
     * cafe). `false` = toujours applique (le gobelet).
     *
     * Sert a l'affichette d'allergenes : un cafe noir n'a aucun allergene, le
     * meme avec creme en a un. On ne sait pas a l'avance ce que le client
     * demandera, donc l'affichette annonce les allergenes du produit PUIS ceux
     * apportes par les options — « sur demande : lait ». Sans ce drapeau, on ne
     * peut qu'unir les deux listes : jamais faux par omission, mais trop large.
     */
    optionnel: integer('optionnel', { mode: 'boolean' }).notNull().default(false),
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    index('idx_composant_produit').on(table.produitVenteId, table.actif),
    index('idx_composant_ingredient').on(table.ingredientId),
  ],
);

/**
 * Garniture d'un produit transforme : ce qui s'ajoute a la crepe et qui doit
 * entrer dans son cout matiere complet. Non applicable aux produits revendus.
 */
export const produitGarniture = sqliteTable(
  'produit_garniture',
  {
    id: text('id').primaryKey(),
    produitVenteId: text('produit_vente_id')
      .notNull()
      .references(() => produitVente.id),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    quantiteUniteRef: integer('quantite_unite_ref').notNull(),
  },
  (table) => [uniqueIndex('idx_garniture_unique').on(table.produitVenteId, table.ingredientId)],
);

/* ═══════════════════════════════════════════════════════════════════════════
   LOT 2 — Stock, lots et tracabilite
   ═══════════════════════════════════════════════════════════════════════════ */

/**
 * Codes motifs structures (docs/07 §6.8 rang 9 — meilleur rapport valeur/cout
 * de toute la liste des manques).
 *
 * Sans codes, `motif` reste du texte libre et on ne peut pas repondre a « ou
 * fuit la matiere ? », pourtant listee comme axe analytique dans docs/01 §7.
 * La formulation de la litterature retail est sans appel : « si "inconnu" est
 * le plus gros poste au bout de six mois, votre processus est casse. Un ecart
 * qu'on ne peut pas attribuer est un ecart qu'on ne peut pas corriger. »
 *
 * Le texte libre est CONSERVE en complement sur le mouvement, jamais en
 * remplacement.
 */
export const motif = sqliteTable(
  'motif',
  {
    id: text('id').primaryKey(),
    code: text('code').notNull(),
    libelle: text('libelle').notNull(),
    categorie: text('categorie', {
      enum: ['perte', 'ajustement', 'sortie_volontaire', 'statut_lot'],
    }).notNull(),
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [uniqueIndex('idx_motif_code').on(table.code)],
);

/** En-tete d'une reception de marchandise. Chaque ligne cree un `lot`. */
export const reception = sqliteTable(
  'reception',
  {
    id: text('id').primaryKey(),
    /**
     * Numero de document lisible et citable au telephone (`RC-2026-0001`).
     * L'UUID v7 est une excellente cle primaire et un tres mauvais numero de
     * document (docs/07 §6.8 rang 2).
     */
    numero: text('numero').notNull(),
    fournisseurId: text('fournisseur_id')
      .notNull()
      .references(() => fournisseur.id),
    dateReception: text('date_reception').notNull(),
    numeroBonLivraison: text('numero_bon_livraison'),
    montantTotalCents: integer('montant_total_cents'),
    fichierScanPath: text('fichier_scan_path'),
    /** Reference vers `commande_fournisseur`, table du Lot 7. */
    commandeId: text('commande_id'),
    /** `ia_validee` = extraite d'un bon de livraison puis validee ligne a ligne. */
    source: text('source', { enum: ['manuelle', 'ia_validee'] })
      .notNull()
      .default('manuelle'),
    /**
     * Etat du document, comme `production.statut` — et non un `is_annule`, pour
     * ne pas introduire une seconde convention d'annulation dans le meme schema.
     *
     * MANQUAIT jusqu'au 30/07/2026, releve par l'audit « rien ne s'efface » :
     * `annulerReception` existait mais ne pouvait detecter une annulation deja
     * faite qu'indirectement, en inspectant le journal d'audit et l'absence de
     * mouvements `entree` non annules. Une deduction, la ou les trois autres
     * documents annulables portent un etat explicite — et surtout, aucun ecran
     * ne pouvait dire « cette reception est annulee », faute de colonne a lire.
     *
     * L'annulation reste une CONTREPASSATION (regle 5) : ce statut ne remplace
     * pas les mouvements inverses, il les resume.
     */
    statut: text('statut', { enum: ['active', 'annulee'] })
      .notNull()
      .default('active'),
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    uniqueIndex('idx_reception_numero').on(table.numero),
    index('idx_reception_date').on(table.dateReception),
    index('idx_reception_fournisseur').on(table.fournisseurId),
  ],
);

/**
 * Un lot de marchandise recu en une fois. Obligation reglementaire, pas une
 * elegance technique (CLAUDE.md §3, regle n°6).
 *
 * La quantite RESTANTE n'est jamais stockee : elle se calcule comme
 * `quantite_initiale - somme des sorties` (invariant de docs/02). C'est la meme
 * regle que pour le stock global, appliquee au lot.
 */
export const lot = sqliteTable(
  'lot',
  {
    id: text('id').primaryKey(),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    fournisseurId: text('fournisseur_id')
      .notNull()
      .references(() => fournisseur.id),
    receptionId: text('reception_id')
      .notNull()
      .references(() => reception.id),
    numeroLotFournisseur: text('numero_lot_fournisseur'),
    dateReception: text('date_reception').notNull(),
    /** `null` = denree non perissable. La FEFO la sert en DERNIER. */
    dateDlc: text('date_dlc'),
    quantiteInitiale: integer('quantite_initiale').notNull(),
    /**
     * Montant REELLEMENT PAYE pour ce lot, en centimes ENTIERS (regle
     * d'architecture n°3 : « aucun flottant pour de l'argent, nulle part »).
     *
     * On stocke le montant, jamais le taux. Le prix unitaire (0,075 centime par
     * gramme, par exemple) est une DIVISION : il se derive a la lecture par
     * `prix_ligne_cents / quantite_initiale`. Stocker le quotient a la place du
     * montant, comme le faisait la version precedente, detruisait
     * irremediablement le centime paye — et avec lui la seule chose qui rend un
     * lot rapprochable de la facture fournisseur (rapprochement a trois
     * facture <-> reception <-> commande, voir `facture_fournisseur`).
     */
    prixLigneCents: integer('prix_ligne_cents').notNull(),
    /**
     * Un ERP BLOQUE et exige un deblocage explicite trace ; il n'autorise pas
     * au fil de l'eau (docs/07 §6.8 rang 10). La FEFO ne consomme que
     * `disponible`. C'est aussi une exigence AFSCA : un lot suspecte doit
     * pouvoir etre mis en quarantaine avant decision.
     */
    statut: text('statut', { enum: ['disponible', 'quarantaine', 'bloque', 'detruit'] })
      .notNull()
      .default('disponible'),
    motifStatutId: text('motif_statut_id').references(() => motif.id),
    dateChangementStatut: text('date_changement_statut'),
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    // L'index qui porte la FEFO : par ingredient, statut, puis DLC croissante.
    index('idx_lot_fefo').on(table.ingredientId, table.statut, table.dateDlc),
    index('idx_lot_reception').on(table.receptionId),
    index('idx_lot_dlc').on(table.dateDlc),
  ],
);

/**
 * LE journal du stock. Regle d'architecture n°5 : « le stock ne se modifie que
 * par un mouvement. Jamais d'UPDATE direct sur une quantite. »
 *
 * Immuable par construction : aucune correction ne modifie une ligne existante,
 * on ecrit une ligne d'annulation (`is_annule` + `annule_par_id`). C'est
 * pourquoi cette table n'est PAS journalisee dans `journal_audit` — journaliser
 * de l'immuable est un cout pur (docs/07 §1.1).
 */
export const mouvementStock = sqliteTable(
  'mouvement_stock',
  {
    id: text('id').primaryKey(),
    lotId: text('lot_id')
      .notNull()
      .references(() => lot.id),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    /** La quantite est TOUJOURS positive ; le signe est porte par le type. */
    type: text('type', {
      enum: [
        'entree',
        'sortie_production',
        'sortie_vente',
        'perte',
        'ajustement_inventaire',
        'consommation_perso',
      ],
    }).notNull(),
    quantite: integer('quantite').notNull(),
    dateMouvement: text('date_mouvement').notNull(),
    /**
     * Date a laquelle la VALEUR est reputee connue, distincte de la date du
     * mouvement (docs/07 §1.3). La quantite est certaine au mouvement ; le cout
     * ne l'est souvent qu'a la facture. Sans cette distinction, l'arrivee
     * tardive d'une facture obligerait a MODIFIER une ecriture passee.
     */
    valuationDate: text('valuation_date').notNull(),
    /** Vrai sur une ecriture d'ajustement de cout posterieure au mouvement. */
    ajustement: integer('ajustement', { mode: 'boolean' }).notNull().default(false),
    /** Tables des Lots 3 et 4 : pas encore de contrainte de cle etrangere. */
    productionId: text('production_id'),
    sessionId: text('session_id'),
    /** Code motif structure. Le texte libre le complete, ne le remplace pas. */
    motifId: text('motif_id').references(() => motif.id),
    motifTexte: text('motif_texte'),
    coutCents: integer('cout_cents').notNull().default(0),
    /**
     * Vrai si CE mouvement a ete annule par un autre. Une ecriture ne
     * s'efface pas, elle se contrepasse — et une seule fois (docs/07 §1.4).
     */
    isAnnule: integer('is_annule', { mode: 'boolean' }).notNull().default(false),
    annuleParId: text('annule_par_id'),
    creePar: text('cree_par'),
    creeLe: text('cree_le').notNull(),
  },
  (table) => [
    // Index central : le restant d'un lot est une somme sur cette colonne.
    index('idx_mouvement_lot').on(table.lotId, table.isAnnule),
    index('idx_mouvement_ingredient').on(table.ingredientId, table.dateMouvement),
    index('idx_mouvement_production').on(table.productionId),
    index('idx_mouvement_session').on(table.sessionId),
    index('idx_mouvement_date').on(table.dateMouvement),
  ],
);

/**
 * Serie de numeros de document, par nature.
 *
 * « Par defaut, les trous ne sont pas autorises dans les series de numeros,
 * parce que l'historique exact des transactions financieres doit etre
 * disponible pour l'audit, PAR LA LOI » (Microsoft). Cote belge, la tenue de
 * comptabilite informatisee impose une numerotation sequentielle « sans blancs
 * ni lacunes ».
 */
export const serieNumero = sqliteTable(
  'serie_numero',
  {
    id: text('id').primaryKey(),
    /** `reception`, `commande`, `production`, `session`, `registre`… */
    nature: text('nature').notNull(),
    prefixe: text('prefixe').notNull(),
    annee: integer('annee').notNull(),
    dernierNumero: integer('dernier_numero').notNull().default(0),
    /** Faux sur toute serie financiere. Vrai seulement si la loi le tolere. */
    autoriseTrous: integer('autorise_trous', { mode: 'boolean' }).notNull().default(false),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [uniqueIndex('idx_serie_nature_annee').on(table.nature, table.annee)],
);

/* ═══════════════════════════════════════════════════════════════════════════
   LOT 3 — Production
   ═══════════════════════════════════════════════════════════════════════════ */

/**
 * Une fournee de pate.
 *
 * Le lot de pate produit est identifie par `numero_lot_pate` et porte sa propre
 * DLC : c'est lui qui fait le lien entre les lots fournisseurs consommes et la
 * session de vente, donc c'est lui qui rend la tracabilite bidirectionnelle
 * possible (docs/01 module 6).
 *
 * Le theorique et le reel coexistent : la production est enregistree avec ses
 * quantites theoriques au lancement, puis le realise est saisi apres coup. Les
 * deux restent lisibles — c'est de leur ECART que nait l'analyse « ou fuit la
 * matiere ? ».
 */
export const production = sqliteTable(
  'production',
  {
    id: text('id').primaryKey(),
    /** Numero lisible `PR-2026-0001`, sequentiel et sans trou. */
    numero: text('numero').notNull(),
    recetteId: text('recette_id')
      .notNull()
      .references(() => recette.id),
    dateProduction: text('date_production').notNull(),
    statut: text('statut', { enum: ['lancee', 'terminee', 'annulee'] })
      .notNull()
      .default('lancee'),

    /** Ce que la recette prevoyait. Fige au lancement, jamais modifie ensuite. */
    volumeTheoriqueMl: integer('volume_theorique_ml').notNull(),
    crepesTheoriques: integer('crepes_theoriques').notNull(),
    coutMatiereTheoriqueCents: integer('cout_matiere_theorique_cents').notNull(),

    /** Ce qu'on a reellement obtenu. `null` tant que le realise n'est pas saisi. */
    volumeReelMl: integer('volume_reel_ml'),
    crepesReelles: integer('crepes_reelles'),
    coutMatiereReelCents: integer('cout_matiere_reel_cents'),

    /** Lot de pate produit. DLC calculee depuis `duree_conservation_pate_heures`. */
    numeroLotPate: text('numero_lot_pate').notNull(),
    dateDlcPate: text('date_dlc_pate').notNull(),

    /** Session a laquelle la pate est destinee. Table du Lot 4. */
    sessionId: text('session_id'),
    /** Prevision a l'origine de l'ordre. Table du Lot 5. */
    ordrePrevisionId: text('ordre_prevision_id'),
    /**
     * Motif d'un ecart important entre l'ordre propose et ce qui a ete produit.
     * C'est ce motif qui ameliore le modele de prevision (docs/01 module 3).
     */
    ecartMotif: text('ecart_motif'),
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    uniqueIndex('idx_production_numero').on(table.numero),
    uniqueIndex('idx_production_lot_pate').on(table.numeroLotPate),
    index('idx_production_date').on(table.dateProduction),
    index('idx_production_recette').on(table.recetteId),
    index('idx_production_session').on(table.sessionId),
  ],
);

/**
 * Ce qu'une production a reellement consomme, LOT PAR LOT.
 *
 * C'est la table qui porte la tracabilite : elle relie chaque production aux
 * lots fournisseurs precis qui y sont entres. Sans elle, on ne peut pas
 * remonter d'une session de vente jusqu'au sac de farine.
 */
export const productionConsommation = sqliteTable(
  'production_consommation',
  {
    id: text('id').primaryKey(),
    productionId: text('production_id')
      .notNull()
      .references(() => production.id),
    lotId: text('lot_id')
      .notNull()
      .references(() => lot.id),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    quantiteTheorique: integer('quantite_theorique').notNull(),
    /** `null` tant que le realise n'a pas ete saisi ingredient par ingredient. */
    quantiteReelle: integer('quantite_reelle'),
    coutCents: integer('cout_cents').notNull(),
  },
  (table) => [
    index('idx_consommation_production').on(table.productionId),
    index('idx_consommation_lot').on(table.lotId),
    index('idx_consommation_ingredient').on(table.ingredientId),
  ],
);

/* ═══════════════════════════════════════════════════════════════════════════
   LOT 4 — Sessions de marche et comptabilite analytique
   ═══════════════════════════════════════════════════════════════════════════ */

export const lieuMarche = sqliteTable('lieu_marche', {
  id: text('id').primaryKey(),
  nom: text('nom').notNull(),
  adresse: text('adresse'),
  latitude: real('latitude'),
  longitude: real('longitude'),
  /** 0 = dimanche, comme `Date.getDay()`. La Batte se tient le dimanche. */
  jourSemaine: integer('jour_semaine'),
  heureDebut: text('heure_debut'),
  heureFin: text('heure_fin'),
  tarifEmplacementCents: integer('tarif_emplacement_cents'),
  modeTarification: text('mode_tarification', {
    enum: ['metre_lineaire_mois', 'jour', 'forfait'],
  }),
  metresLineaires: integer('metres_lineaires'),
  /**
   * Rayon de recherche d'evenements autour de ce lieu, en kilometres (fiche 05).
   *
   * Reglable PAR LIEU et non globalement : un marche de centre-ville et un
   * marche de village n'ont pas le meme bassin d'evenements influents. Valeurs
   * admises 5 | 10 | 15 | 20 | 40 | 100, defaut 20 — la contrainte est portee
   * par le contrat Zod et non par un CHECK SQL, comme tous les domaines de
   * valeurs du projet.
   *
   * ATTENTION : ce rayon ne dit PAS « Wallonie ». Un rayon de 100 km autour de
   * Liege atteint Maastricht et Aix-la-Chapelle. Rayon et perimetre regional
   * sont deux filtres distincts (fiche 14 §4).
   */
  rayonRechercheEvenementsKm: integer('rayon_recherche_evenements_km').notNull().default(20),
  /**
   * Distance ROUTIERE aller simple depuis le point de depart habituel, en km
   * entiers (fiche 13).
   *
   * CALCULEE, plus saisie a la main (D-065, 30/07/2026). Le commentaire
   * precedent justifiait la saisie manuelle par l'imprecision d'une distance a
   * vol d'oiseau — l'argument etait juste, mais il visait la mauvaise cible :
   * ce n'est pas une distance a vol d'oiseau, c'est un itineraire routier rendu
   * par OpenRouteService (`apps/api/src/itineraire/client.ts`, cable dans
   * `routes/referentiel-ecriture.ts`). Le porteur relit et corrige ; le calcul
   * ne recrase jamais une valeur qu'il a validee.
   *
   * ENTIER, et c'est desormais discutable : le service rend des metres, donc
   * l'arrondi au km jette une precision obtenue gratuitement. Il se propage —
   * les km reels d'une session sont pre-remplis a 2 x cette valeur (D-064) et
   * `session_marche.distance_reelle_km` est, elle, declaree `real`. Passer
   * cette colonne en `real` demande une reconstruction de table sous Drizzle
   * (hors du perimetre sur de D-044), donc ce n'est PAS fait ici : voir D-074.
   *
   * NULLABLE : `NULL` veut dire « pas encore renseignee », jamais « zero km ».
   * Un lieu sans distance ne peut pas etre compare aux autres sur la marge
   * nette — l'ecran doit le dire au lieu de le classer premier.
   *
   * DECLAREE `integer`, mais elle PORTE DES DECIMALES depuis le 31/07/2026, et
   * ce n'est pas un accident (D-074). L'arrondi au kilometre est supprime a la
   * source : `apps/api/src/itineraire/client.ts` arrondit desormais au dixieme
   * (100 m), parce qu'OpenRouteService rend des metres et qu'un itineraire n'est
   * de toute facon pas exact au metre. Mesure sur un cas reel : 12 437 m
   * donnaient 24 km au lieu de 24,8 une fois doubles, soit 38 centimes perdus en
   * silence sur UNE session, et un biais systematique entre lieux.
   *
   * POURQUOI LE TYPE N'A PAS SUIVI, et c'est verifie et non suppose : passer en
   * `real` oblige SQLite a RECONSTRUIRE la table, et Drizzle applique ses
   * migrations DANS une transaction — or `PRAGMA foreign_keys=OFF` est sans
   * effet a l'interieur d'une transaction. La reconstruction generee echoue donc
   * en `FOREIGN KEY constraint failed` des que la table est referencee, ce
   * qu'elle est (sessions, observations meteo). Essaye sur une COPIE de la base
   * reelle le 31/07/2026 : impossible, pas seulement risquee. C'est la preuve
   * empirique de la regle posee en D-044.
   *
   * SANS CONSEQUENCE FONCTIONNELLE : l'affinite NUMERIC de SQLite conserve 12,4
   * tel quel dans une colonne declaree `INTEGER` — elle ne convertit que si la
   * conversion est reversible sans perte. Verifie par des tests d'aller-retour
   * reels (`packages/db/src/depots/lieux-rentabilite.test.ts`).
   */
  distanceKm: integer('distance_km'),
  /**
   * Mode de facturation de l'electricite sur cet emplacement (fiche 17).
   *
   * `NULL` = inconnu. Ce n'est PAS « au compteur » : sur beaucoup de marches
   * l'electricite est comprise dans le prix de l'emplacement ou facturee au
   * forfait journalier. Calculer une consommation en kWh dans ces cas
   * inventerait un cout qui n'existe pas, et le compterait DEUX FOIS avec le
   * tarif d'emplacement.
   */
  facturationElectricite: text('facturation_electricite', {
    enum: ['compteur', 'forfait', 'comprise', 'aucune'],
  }),
  /**
   * Puissance electrique disponible sur l'emplacement, en watts.
   *
   * Ce n'est pas la meme chose que l'energie consommee : la puissance
   * s'additionne A L'INSTANT. Trois radiateurs de 1 500 W allumes ensemble
   * demandent 4 500 W, or une prise de marche fournit souvent 16 A (~3 500 W).
   * Au-dela, ca disjoncte — le matin, quand tout demarre en meme temps.
   */
  puissanceDisponibleW: integer('puissance_disponible_w'),
  actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
  notes: text('notes'),
  creeLe: text('cree_le').notNull(),
  modifieLe: text('modifie_le').notNull(),
});

/**
 * Une journee de presence sur un marche, du depart au retour.
 *
 * Les agregats (`ca_total_cents`, marges…) sont STOCKES et non recalcules a la
 * volee : une session close est une piece comptable, elle doit rester lisible
 * telle qu'elle a ete arretee, meme si un prix de produit change ensuite. C'est
 * une denormalisation assumee, controlee par l'invariant n°3 de docs/02.
 */
export const sessionMarche = sqliteTable(
  'session_marche',
  {
    id: text('id').primaryKey(),
    numero: text('numero').notNull(),
    lieuId: text('lieu_id')
      .notNull()
      .references(() => lieuMarche.id),
    /**
     * EVENEMENT qui a motive cette session (fiche 14).
     *
     * Sans ce lien, rien ne relie une session close a l'opportunite qui l'a
     * fait exister — et le taux de prise en entreprise (effectif x taux) ne
     * peut donc JAMAIS s'apprendre : la premiere fois est un pari, et la
     * seconde aussi. C'est le meme motif que `impact_mesure_bp`, declare et
     * jamais ecrit, refermee le 29/07 pour les evenements-facteurs.
     *
     * `NULL` = session reguliere, non motivee par un evenement. C'est le cas
     * majoritaire et il le restera.
     */
    evenementId: text('evenement_id').references(() => evenement.id),
    dateSession: text('date_session').notNull(),
    heureDebutReelle: text('heure_debut_reelle'),
    heureFinReelle: text('heure_fin_reelle'),
    /**
     * `'en_cours'` RETIRÉ le 01/08/2026, et le motif est structurel, pas
     * cosmétique. Ce statut n'était écrit par AUCUN chemin — vérifié par
     * dérivation : `services/sessions.ts` n'écrit que `'planifiee'` (:381),
     * `'cloturee'` (:1450) et `'annulee'` (:1884). Et il ne pouvait pas
     * l'être : `CLAUDE.md` §1 pose « aucun usage sur le stand pendant le
     * marché ». Un statut « en cours » n'a pas de sens dans une application
     * qu'on n'ouvre ni avant ni pendant — la saisie se fait avant et après.
     *
     * Aucune migration nécessaire : sous SQLite, `enum` est une contrainte
     * TYPESCRIPT, pas un `CHECK` SQL (vérifié — aucune migration n'en porte).
     * La colonne reste `text NOT NULL DEFAULT 'planifiee'`, inchangée.
     *
     * Laisser un état mort dans une énum n'est pas neutre : le verrou
     * comptable `periode.statut = 'verrouillee'` a coûté une demi-journée
     * d'enquête pour exactement cette raison — deux gardes le lisaient, rien
     * ne le posait jamais, et son existence laissait croire à une protection.
     */
    statut: text('statut', { enum: ['planifiee', 'cloturee', 'annulee'] })
      .notNull()
      .default('planifiee'),
    /**
     * Exclut la session de l'estimation du modele de prevision : panne de gaz,
     * arrivee en retard, fermeture anticipee. Exige par docs/03 et absent du
     * modele d'origine (docs/07 §6, defaut n°2).
     */
    exclureDuModele: integer('exclure_du_modele', { mode: 'boolean' }).notNull().default(false),
    motifExclusion: text('motif_exclusion'),

    meteoPrevue: text('meteo_prevue', { mode: 'json' }),
    meteoReelle: text('meteo_reelle', { mode: 'json' }),

    /**
     * Monnaie emportee le matin. Ne fait PAS partie du chiffre d'affaires —
     * sans ce champ, l'invariant n°4 de docs/02 est faux (corrige le 27/07/2026).
     */
    fondsCaisseInitialCents: integer('fonds_caisse_initial_cents').notNull().default(0),
    /** Especes comptees au retour, fonds initial COMPRIS. */
    especesCompteesCents: integer('especes_comptees_cents'),
    caCarteCents: integer('ca_carte_cents'),
    /** Derive : `especes_comptees - fonds_initial`. Jamais saisi. */
    caEspecesCents: integer('ca_especes_cents'),
    ecartCaisseCents: integer('ecart_caisse_cents'),

    caTotalCents: integer('ca_total_cents'),
    /** Ventilation indispensable aux compteurs de seuils legaux (CLAUDE.md §6). */
    caTransformeCents: integer('ca_transforme_cents'),
    caRevenduCents: integer('ca_revendu_cents'),
    /** CA des services de restauration sur place — seuil SCE, distinct de la TVA. */
    caSurPlaceCents: integer('ca_sur_place_cents'),
    nbTransactions: integer('nb_transactions'),

    coutMatiereCents: integer('cout_matiere_cents'),
    commissionCarteCents: integer('commission_carte_cents'),
    fraisEmplacementCents: integer('frais_emplacement_cents').notNull().default(0),
    fraisDeplacementCents: integer('frais_deplacement_cents').notNull().default(0),
    fraisGazCents: integer('frais_gaz_cents').notNull().default(0),
    fraisDiversCents: integer('frais_divers_cents').notNull().default(0),

    /*
     * ═══ Le deplacement est une TOURNEE, pas un aller-retour (D-064) ═══
     *
     * Ces deux colonnes viennent d'une correction du porteur. La fiche 13
     * demandait « le cout compte-t-il 2 x la distance ? » ; sa reponse a ete
     * qu'un trajet reel enchaine domicile -> marche -> parfois un autre marche
     * -> parfois un fournisseur -> retour. La question presupposait un modele
     * faux.
     */

    /**
     * Point de depart REEL de cette session, quand ce n'est pas le domicile.
     *
     * `null` = on est parti du domicile, l'adresse en parametre. Surcharge et
     * non remplacement : le cas courant ne demande aucune saisie.
     */
    pointDepartTexte: text('point_depart_texte'),

    /**
     * Kilometres REELLEMENT parcourus pour cette session, tournee comprise.
     *
     * A ne pas confondre avec `lieu_marche.distance_km`, qui est une distance de
     * REFERENCE aller simple servant a arbitrer AVANT d'y aller. Ici c'est une
     * MESURE, connue seulement apres — meme couple theorique/reel que
     * `cout_matiere_theorique_cents` contre `cout_matiere_reel_cents` (D-038).
     *
     * `null` = pas encore saisi, JAMAIS 0. Un zero ferait croire a une session
     * sans deplacement, donc gratuite en carburant et en usure.
     *
     * REEL et non entier : c'est une distance lue sur un compteur ou sur une
     * carte (« 23,4 km »), pas un montant — l'invariant des entiers ne porte que
     * sur l'argent, les masses et les volumes.
     */
    distanceReelleKm: real('distance_reelle_km'),

    /*
     * ═══ L'imputation de la tournee est FIGEE a la cloture ═══
     *
     * Miroir exact de `cout_matiere_theorique_cents` / `cout_matiere_reel_cents`
     * (D-038), et le raisonnement qui a conduit a figer plutot qu'a recalculer
     * merite d'etre garde ici, parce qu'il va contre la doctrine dominante du
     * projet (le CUMP, lui, ne se stocke jamais — D-018, D-020).
     *
     * Le CUMP decrit un etat COURANT : le stock qui reste en rayon aujourd'hui.
     * Le recalculer a chaque lecture est juste par construction. L'imputation,
     * elle, decrit un FAIT PASSE : des kilometres deja roules pour une session
     * deja close.
     *
     * Et l'un de ses intrants derive : `coutKilometriqueRetenu` en mode
     * « mesure » (`mesureCoutVehicule`) est une moyenne GLOBALE SANS DATE DE
     * VALIDITE, qui grossit a chaque nouvelle depense de carburant et a chaque
     * session close — contrairement a `lireParametres`, qui est date. Recalculer
     * a la lecture ferait donc deriver le partage session/achats d'une session
     * close il y a des mois a chaque donnee future : exactement la piece
     * comptable qui se reecrit toute seule, que la regle n°7 du §3 interdit.
     *
     * `null` partout = pas calculable (distance reelle non saisie), jamais 0.
     */

    /** Part portee par la session : ce qu'elle aurait coute SEULE (2 x reference). */
    coutDeplacementReelSessionCents: integer('cout_deplacement_reel_session_cents'),
    /**
     * Part causee par le detour — passage chez un fournisseur, second marche.
     *
     * VISIBLE mais volontairement PAS auto-comptabilisee. Deux raisons : aucun
     * lien session -> reception n'existe dans le modele, et un detour peut etre
     * un fournisseur comme un second marche (D-064) — rattacher automatiquement
     * inventerait un fait. Surtout, l'inscrire en depense `carburant` serait un
     * piege : `mesureCarburant` somme deja TOUTES les lignes de cette categorie
     * pour nourrir le taux kilometrique mesure. Une ligne calculee A PARTIR de ce
     * taux compterait deux fois le meme plein reel et ferait deriver la mesure a
     * la hausse, sans borne, session apres session.
     */
    coutDeplacementReelDetourAchatsCents: integer('cout_deplacement_reel_detour_achats_cents'),
    /**
     * Total reel. Redondant avec la somme des deux parts SEULEMENT quand elles
     * sont connues : quand la distance de reference du lieu manque, on ne peut
     * pas separer les parts (`null`) alors que le total, lui, reste calculable.
     * C'est ce cas qui rend cette troisieme colonne necessaire.
     */
    coutDeplacementReelTotalCents: integer('cout_deplacement_reel_total_cents'),

    crepesProduites: integer('crepes_produites').notNull().default(0),
    /**
     * COMMENT `crepes_produites` a ete obtenu, et la MESURE d'origine.
     *
     * Deux facons de cloturer, au choix (D-057) : compter les crepes, ou
     * mesurer la pate restante dans le bac. Dans le second cas,
     * `crepes_produites` est DEDUIT — et sans ces deux colonnes, la mesure qui
     * a servi au calcul disparaissait a la cloture. On ne pouvait donc plus
     * reconstituer d'ou venait le nombre, ni le reverifier.
     *
     * Meme raison d'etre que `especes_comptees_cents` : ce que l'utilisateur a
     * MESURE se conserve, ce qui en est derive se recalcule. `NULL` sur les
     * sessions closes avant cette colonne, et sur le mode « je compte les
     * crepes » ou aucun volume n'est mesure.
     */
    modeCloture: text('mode_cloture', { enum: ['crepes', 'volume'] }),
    volumeRestantMesureMl: integer('volume_restant_mesure_ml'),
    crepesVendues: integer('crepes_vendues').notNull().default(0),
    crepesInvendues: integer('crepes_invendues').notNull().default(0),
    crepesCassees: integer('crepes_cassees').notNull().default(0),

    margeBruteCents: integer('marge_brute_cents'),
    margeNetteCents: integer('marge_nette_cents'),
    notesQualitatives: text('notes_qualitatives'),
    dateCloture: text('date_cloture'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    uniqueIndex('idx_session_numero').on(table.numero),
    index('idx_session_date').on(table.dateSession),
    index('idx_session_statut').on(table.statut),
    index('idx_session_lieu').on(table.lieuId),
    /** Filtre reel sans index jusqu'au 30/07/2026 : « les sessions de CET evenement ». */
    index('idx_session_evenement').on(table.evenementId),
  ],
);

