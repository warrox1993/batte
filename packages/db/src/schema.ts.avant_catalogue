/* ═══════════════════════════════════════════════════════════════════════════
   Fiche 12 — Suivi des economies d'achat (inspire du classeur Mithra
   Pharmaceuticals, docs/demandes/12-MODULE-ECONOMIES-ACHAT-INSPIRE-MITHRA.md)
   ═══════════════════════════════════════════════════════════════════════════ */

/**
 * Une action de reduction de cout, capturee en avant/apres de prix : trois
 * types identifies dans le fichier source — negociation de prix, achat d'une
 * alternative moins chere, remplacement par du stock deja immobilise.
 *
 * PAS de colonne `economie_cents` ici, et c'est une decision deliberee.
 *
 * La fiche source demande cette colonne tout en enoncant elle-meme le principe
 * qui l'interdit : « economie_cents se recalcule toujours depuis
 * (avant - apres) x quantite, jamais stocke independamment du calcul — une
 * valeur qui peut diverger de son calcul source est une source de bug ». C'est
 * exactement le defaut deja corrige deux fois sur ce schema :
 *  - D-018 : le CUMP n'est pas une colonne d'`ingredient`, il se calcule depuis
 *    le conditionnement actif ;
 *  - D-044 : on stocke le MONTANT PAYE (`prix_ligne_cents`), jamais le TAUX
 *    derive — parce qu'un quotient stocke peut diverger de sa source par un
 *    arrondi de division en virgule flottante.
 *
 * Ici la situation est en realite MOINS ambigue que ces deux precedents :
 * l'economie n'est ni une moyenne ponderee (CUMP) ni un quotient non
 * representable en binaire (D-044) — c'est une SOUSTRACTION puis un PRODUIT de
 * trois entiers deja stockes ci-dessous (`prix_unitaire_avant_cents`,
 * `prix_unitaire_apres_cents`, `quantite_concernee`), donc un calcul EXACT,
 * sans la moindre perte de precision, contrairement a la division qui a motive
 * D-044. Stocker un nombre qui se recalcule EXACTEMENT et SANS RISQUE
 * d'arrondi a partir de trois colonnes deja presentes ne protegerait
 * absolument rien et creerait une dette pure : si l'une des trois colonnes est
 * corrigee apres coup (faute de frappe sur la quantite, prix mal releve), un
 * `economie_cents` fige divergerait silencieusement de sa propre source — la
 * pire espece de bug, invisible tant qu'on ne recalcule pas a la main. Le
 * calcul vit dans `packages/core/src/economies.ts`
 * (`calculerEconomieCents`), fonction pure et testee isolement, appelee a
 * chaque lecture par le depot (`packages/db/src/depots/economies.ts`) —
 * jamais a l'ecriture.
 */
export const economieAchat = sqliteTable(
  'economie_achat',
  {
    id: text('id').primaryKey(),
    /** Jour civil belge de l'action (date de la negociation ou du constat). */
    dateAction: text('date_action').notNull(),
    ingredientId: text('ingredient_id')
      .notNull()
      .references(() => ingredient.id),
    fournisseurId: text('fournisseur_id')
      .notNull()
      .references(() => fournisseur.id),
    /**
     * Renseigne quand l'economie s'accroche a un tarif precis de
     * `conditionnement` (D-018 : le prix d'achat vit sur le conditionnement,
     * jamais sur l'ingredient). Nullable : un « remplacement de stock
     * immobilise » ou un « achat alternatif » chez un nouveau fournisseur n'a
     * pas toujours de conditionnement de reference deja en base.
     */
    conditionnementId: text('conditionnement_id').references(() => conditionnement.id),
    typeAction: text('type_action', {
      enum: ['negociation_prix', 'achat_alternatif', 'remplacement_stock_immobilise', 'autre'],
    }).notNull(),
    /** La justification de l'action — texte libre, comme la colonne
     * « Description » du fichier Mithra source. */
    description: text('description').notNull(),
    /**
     * En centimes ENTIERS (regle n°3). Prix par UNITE DE NEGOCIATION — le kg,
     * le carton, le conditionnement lui-meme — PAS necessairement l'unite de
     * reference brute de l'ingredient (g/ml). C'est volontaire : un prix par
     * gramme tombe presque toujours sur une fraction de centime (0,80 €/kg =
     * 0,08 centime/g), ce que la regle n°3 interdit de stocker. L'utilisateur
     * choisit donc la granularite ou le prix s'exprime en centimes entiers —
     * exactement comme au classeur source (« 0,80 €/kg », jamais « €/g ») et
     * comme `conditionnement.prix_cents`, deja exprime pour la contenance
     * entiere du conditionnement, jamais pour son unite de reference.
     */
    prixUnitaireAvantCents: integer('prix_unitaire_avant_cents').notNull(),
    prixUnitaireApresCents: integer('prix_unitaire_apres_cents').notNull(),
    /** Nombre d'unites de negociation concernees (le volume evoque au critere
     * de fin de la fiche : « sur un volume donne »), dans la MEME unite que
     * les deux prix ci-dessus — jamais une conversion implicite (regle n°4). */
    quantiteConcernee: integer('quantite_concernee').notNull(),
    /** Reference vers `commande_fournisseur`, si l'economie est liee a une commande precise. */
    commandeId: text('commande_id').references(() => commandeFournisseur.id),
    /** Pas d'authentification en V1 (docs/02) : sert uniquement a tracer qui a saisi quoi. */
    saisiPar: text('saisi_par'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    index('idx_economie_date').on(table.dateAction),
    index('idx_economie_ingredient').on(table.ingredientId),
    index('idx_economie_fournisseur').on(table.fournisseurId),
    // Ventilation par type et par mois : c'est exactement la lecture du
    // tableau de bord (feuille « CHART_COST REDUCTION » du fichier source).
    index('idx_economie_type_date').on(table.typeAction, table.dateAction),
  ],
);

/* ═══════════════════════════════════════════════════════════════════════════
   Concurrents (docs/demandes/08-FICHES-CONCURRENTS.md) — repertorier les
   vendeurs concurrents observes sur les marches (les deux vendeurs de crepes
   deja reperes a La Batte en sont le premier exemple), avec leurs produits et
