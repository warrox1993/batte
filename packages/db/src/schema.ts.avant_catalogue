/**
 * EQUIPEMENT electrique du stand (fiche 17).
 *
 * Le porteur a tranche : le chauffage sera electrique, et « il peut y avoir
 * plusieurs sortes de radiateurs qui tournent en meme temps ». Ce n'est donc
 * pas « le radiateur » qu'on modelise mais l'EQUIPEMENT — un seul concept
 * couvre radiateurs, eclairage, terminal de paiement, froid actif et plaques
 * electriques la ou le lieu le permet.
 *
 * DEUX GRANDEURS A NE PAS CONFONDRE, et c'est tout l'interet de cette table :
 * - la PUISSANCE (W) s'additionne A L'INSTANT et determine ce qui passe dans
 *   le cable. Trois radiateurs de 1 500 W demandent 4 500 W simultanes, or une
 *   prise de marche fournit souvent 16 A (~3 500 W) : au-dela, ca DISJONCTE,
 *   le matin, quand tout demarre en meme temps ;
 * - l'ENERGIE (puissance x duree) determine ce qu'on PAIE.
 *
 * La consommation est SAISIE A LA MAIN, depuis la plaque signaletique : rien
 * n'est code en dur, changer d'appareil est un changement de parametre. Et un
 * appareil peut etre declare sans etre en service, precisement pour comparer
 * ce que couterait un modele avant de l'acheter.
 */
export const equipement = sqliteTable(
  'equipement',
  {
    id: text('id').primaryKey(),
    nom: text('nom').notNull(),
    type: text('type', {
      enum: ['chauffage', 'eclairage', 'froid', 'cuisson', 'paiement', 'autre'],
    }).notNull(),
    /** Puissance nominale, relevee sur la plaque signaletique. */
    puissanceW: integer('puissance_w').notNull(),
    /** `false` = declare pour comparaison avant achat, pas en service. */
    enService: integer('en_service', { mode: 'boolean' }).notNull().default(false),
    notes: text('notes'),
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [index('idx_equipement_service').on(table.enService, table.actif)],
);

/**
 * Duree d'utilisation d'un equipement sur une session donnee.
 *
 * Le cout se derive : puissance x duree x prix du kWh. Mais le prix du kWh ne
 * s'applique QUE si le lieu facture au compteur — sur beaucoup d'emplacements
 * l'electricite est comprise dans le tarif ou facturee au forfait, et calculer
 * des kWh y inventerait un cout qui n'existe pas, compte DEUX FOIS avec le
 * tarif d'emplacement (voir `lieu_marche.facturation_electricite`).
 */
export const equipementSession = sqliteTable(
  'equipement_session',
  {
    id: text('id').primaryKey(),
    sessionId: text('session_id')
      .notNull()
      .references(() => sessionMarche.id),
    equipementId: text('equipement_id')
      .notNull()
      .references(() => equipement.id),
    dureeMinutes: integer('duree_minutes').notNull(),
    creeLe: text('cree_le').notNull(),
  },
  (table) => [
    uniqueIndex('idx_equipement_session').on(table.sessionId, table.equipementId),
    index('idx_equipement_session_equipement').on(table.equipementId),
  ],
);

/**
 * Composition d'un MENU (fiche 16) : un produit de vente fait d'autres
 * produits de vente, avec son PROPRE prix.
 *
 * C'est tout l'interet commercial — crepe a 3,50 EUR + cafe a 2,00 EUR vendus
 * 5,00 EUR — et c'est aussi le piege : les 50 centimes de remise doivent etre
 * REPARTIS, sinon le menu reste un bloc et la ventilation transforme/revendu
 * devient fausse. Or cette ventilation alimente les compteurs de seuils legaux
 * (CLAUDE.md §6), ou la revente genere ~2,6 fois plus de CA pour une meme
 * marge. Un menu non ventile fausse donc le compteur de franchise TVA.
 *
 * A ne pas confondre avec `produit_vente_composant`, qui dit ce qu'un produit
 * consomme en INGREDIENTS a la vente. Ici c'est produit -> produit.
 */
export const menuComposition = sqliteTable(
  'menu_composition',
  {
    id: text('id').primaryKey(),
    menuId: text('menu_id')
      .notNull()
      .references(() => produitVente.id),
    produitInclusId: text('produit_inclus_id')
      .notNull()
      .references(() => produitVente.id),
    quantite: integer('quantite').notNull().default(1),
    /**
     * Prix IMPOSE de ce composant dans ce menu, en centimes. `NULL` = il se
     * repartit au prorata.
     *
     * Les deux methodes de repartition de la remise coexistent volontairement
     * (« quand tu ne sais pas, realise les deux options complementaires ») :
     * le prorata ne demande aucune saisie, le prix impose colle a la realite
     * commerciale. Quelle que soit la methode, la somme des parts vaut
     * EXACTEMENT le prix du menu — sinon la ventilation transforme/revendu
     * serait fausse, et avec elle le compteur de franchise TVA.
     */
    prixForceCents: integer('prix_force_cents'),
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    uniqueIndex('idx_menu_composition').on(table.menuId, table.produitInclusId),
    index('idx_menu_composition_inclus').on(table.produitInclusId),
  ],
);

/**
 * OBJECTIF que le porteur se fixe (fiche 18 §4).
 *
 * L'application savait ce qui s'etait passe et ce qui allait se passer. Elle ne
 * savait pas ce qu'il VISE — c'est un vrai manque d'ERP, ou ca s'appelle un
 * budget. Se fixer une cible et voir l'ecart au fil du temps est utile MEME
 * SANS un seul badge : les succes n'en sont que la couche d'affichage.
 *
 * `valeurCible` est en CENTIMES pour les grandeurs monetaires, en compte entier
 * pour `nombre_sessions` (regle n°3 : jamais de flottant).
 *
 * Correction par CONTRE-ECRITURE dans `notes` (marqueur `[ANNULATION:<id>]`),
 * exactement comme `depense` — aucune colonne `is_annule` necessaire, et rien
 * ne s'efface (regle n°7).
 */
export const objectif = sqliteTable('objectif', {
  id: text('id').primaryKey(),
  grandeur: text('grandeur', {
    enum: ['chiffre_affaires', 'marge_nette', 'nombre_sessions', 'cout_matiere_par_crepe'],
  }).notNull(),
  dateDebut: text('date_debut').notNull(),
  dateFin: text('date_fin').notNull(),
  valeurCible: integer('valeur_cible').notNull(),
  notes: text('notes'),
  creeLe: text('cree_le').notNull(),
  modifieLe: text('modifie_le').notNull(),
});
