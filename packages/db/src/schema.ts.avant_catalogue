   LIMITE ASSUMEE, a ecrire aussi a l'ecran (apps/web/src/pages/Concurrents.tsx) :
   le moteur de prevision (docs/03) ne consomme PAS cette donnee en V1. Un
   concurrent est un facteur de REPARTITION de la clientele entre vendeurs,
   jamais de la demande TOTALE du marche.
   ═══════════════════════════════════════════════════════════════════════════ */

export const concurrent = sqliteTable(
  'concurrent',
  {
    id: text('id').primaryKey(),
    nom: text('nom').notNull(),
    /** Un concurrent est observe a un endroit precis, jamais « en general ». */
    lieuId: text('lieu_id')
      .notNull()
      .references(() => lieuMarche.id),
    typeOffre: text('type_offre', {
      enum: ['crepes', 'gaufres', 'autre_sucre', 'sale', 'mixte'],
    }).notNull(),
    positionnement: text('positionnement', {
      enum: ['bas_de_gamme', 'standard', 'premium'],
    }).notNull(),
    emplacementObserve: text('emplacement_observe'),
    /**
     * 1 a 5 — appreciation SUBJECTIVE assumee comme telle (fiche 08), jamais
     * une mesure. L'ecran doit le rappeler a chaque affichage.
     */
    qualitePercue: integer('qualite_percue').notNull(),
    /**
     * Derivee des produits et observations enregistrees (mise a jour a chaque
     * ajout, voir packages/db/src/depots/concurrents.ts) : alimente l'encart
     * « a revisiter » du tableau de bord sans recalcul a la lecture.
     */
    dateDerniereObservation: text('date_derniere_observation'),
    notesGenerales: text('notes_generales'),
    /**
     * Meme convention que fournisseur / ingredient / produit_vente / lieu_marche
     * (CLAUDE.md §3 regle 7) : on desactive, on ne supprime jamais. Un
     * concurrent qui a quitte le marche disparait des listes actives mais son
     * historique de prix reste lisible.
     */
    actif: integer('actif', { mode: 'boolean' }).notNull().default(true),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    index('idx_concurrent_lieu').on(table.lieuId),
    index('idx_concurrent_actif').on(table.actif),
  ],
);

/**
 * Prix releve chez un concurrent — HISTORISE : une ligne par releve, jamais un
 * UPDATE en place (fiche 08 : « un meme produit peut etre observe a des prix
 * differents dans le temps »). Ne JAMAIS aplatir cette table en « dernier prix
 * connu » : c'est le depot qui projette le dernier prix a la LECTURE
 * (packages/db/src/depots/concurrents.ts) ; la table garde tout l'historique.
 */
export const concurrentProduit = sqliteTable(
  'concurrent_produit',
  {
    id: text('id').primaryKey(),
    concurrentId: text('concurrent_id')
      .notNull()
      .references(() => concurrent.id),
    nomProduit: text('nom_produit').notNull(),
    /** Centimes entiers (regle n°3). */
    prixCents: integer('prix_cents').notNull(),
    description: text('description'),
    dateObservation: text('date_observation').notNull(),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    index('idx_concurrent_produit_concurrent').on(table.concurrentId),
    // Sert a la projection « dernier prix par produit » : le plus recent
    // d'abord, pour un concurrent et un nom de produit donnes.
    index('idx_concurrent_produit_historique').on(
      table.concurrentId,
      table.nomProduit,
      table.dateObservation,
    ),
  ],
);

/**
 * Visite de terrain chez un concurrent : affluence, file d'attente, notes
 * libres. Formulaire de saisie rapide « apres une visite » (fiche 08), meme
 * esprit que la cloture de session.
 */
export const concurrentObservation = sqliteTable(
  'concurrent_observation',
  {
    id: text('id').primaryKey(),
    concurrentId: text('concurrent_id')
      .notNull()
      .references(() => concurrent.id),
    dateObservation: text('date_observation').notNull(),
    affluenceEstimee: text('affluence_estimee', {
      enum: ['nulle', 'faible', 'moyenne', 'forte'],
    }).notNull(),
    fileAttente: integer('file_attente', { mode: 'boolean' }).notNull().default(false),
    /** Texte libre : ce que l'utilisateur a goute, vu, remarque (fiche 08). */
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [
    index('idx_concurrent_observation_concurrent').on(table.concurrentId),
    index('idx_concurrent_observation_date').on(table.dateObservation),
  ],
);

