/* ═══════════════════════════════════════════════════════════════════════════
   LOT 6 — Documents generes
   ═══════════════════════════════════════════════════════════════════════════ */

/**
 * Tout document EMIS est archive, jamais regenere.
 *
 * C'est le manque le plus insidieux releve par la recherche (docs/07 §6.5) :
 * `docs/06` prevoyait un endpoint qui GENERE le PDF a la demande. Si un prix,
 * un seuil ou une recette change entre-temps, le registre AFSCA regenere en
 * septembre DIFFERE de celui presente au controle en mars — et le controleur,
 * lui, en a garde une copie. Un ERP archive le document pose, il ne le
 * recalcule pas.
 *
 * L'empreinte SHA-256 permet de prouver qu'un fichier n'a pas ete altere depuis
 * son emission. Regenerer cree une NOUVELLE VERSION numerotee, jamais un
 * ecrasement.
 */
export const documentGenere = sqliteTable(
  'document_genere',
  {
    id: text('id').primaryKey(),
    type: text('type', {
      enum: [
        'fiche_technique',
        'affichette_allergenes',
        'etiquette_bac',
        'bon_commande',
        'brief_avant_marche',
        'rapport_session',
        'registre_afsca',
        'export_excel',
        /**
         * FICHE DE RAPPEL, ajoutée le 01/08/2026 — le seul document tiré par
         * LOT et non par période. Elle répond à la question d'un rappel
         * fournisseur : « quel lot de pâte est issu d'une production ayant
         * consommé ce lot d'ingrédient ? », et remonte jusqu'aux sessions où
         * ces productions sont parties.
         *
         * Pourquoi un document DÉDIÉ et non une section du registre mensuel :
         * un lot à longue conservation se reçoit en mai, se consomme en
         * juillet et se vend en août — aucun mois ne contient la chaîne
         * entière. La clé d'entrée d'un rappel est un LOT, jamais un mois.
         *
         * Aucune migration : sous SQLite, `enum` est une contrainte
         * TYPESCRIPT, pas un `CHECK` SQL — vérifié sur CETTE colonne, pas
         * déduit par analogie.
         */
        'fiche_rappel',
      ],
    }).notNull(),
    /** Objet source : recette, session, commande… Selon le type. */
    objetId: text('objet_id'),
    /** Numero lisible du document, quand il en porte un. */
    numero: text('numero'),
    version: integer('version').notNull().default(1),
    dateGeneration: text('date_generation').notNull(),
    chemin: text('chemin').notNull(),
    tailleOctets: integer('taille_octets').notNull(),
    /** Preuve d'integrite : le fichier n'a pas bouge depuis son emission. */
    hashSha256: text('hash_sha256').notNull(),
    /**
     * Instantane des parametres et donnees ayant servi au rendu. Permet de
     * comprendre POURQUOI un document ancien dit ce qu'il dit, meme apres
     * changement des valeurs courantes.
     */
    parametresSource: text('parametres_source', { mode: 'json' }),
    creePar: text('cree_par'),
  },
  (table) => [
    index('idx_document_type_objet').on(table.type, table.objetId),
    index('idx_document_date').on(table.dateGeneration),
    uniqueIndex('idx_document_type_objet_version').on(table.type, table.objetId, table.version),
  ],
);

/* ═══════════════════════════════════════════════════════════════════════════
   LOT 5 — Prevision
   ═══════════════════════════════════════════════════════════════════════════ */

/**
 * Evenement local susceptible de deplacer la frequentation.
 *
 * `impact_estime_bp` est ce qu'on croyait AVANT, `impact_mesure_bp` ce qu'on a
 * constate APRES. Garder les deux est ce qui permet a l'estimation de s'ameliorer
 * — sans quoi on recopie indefiniment la meme intuition.
 */
export const evenement = sqliteTable(
  'evenement',
  {
    id: text('id').primaryKey(),
    nom: text('nom').notNull(),
    type: text('type', {
      enum: [
        'festival',
        'ferie',
        'sportif',
        'meteo_exceptionnelle',
        'greve',
        'travaux',
        'concurrence',
        'autre',
      ],
    }).notNull(),
    dateDebut: text('date_debut').notNull(),
    dateFin: text('date_fin').notNull(),
    portee: text('portee', { enum: ['national', 'liege', 'quartier'] }).notNull(),
    /** 1 a 5. Sert a graduer l'impact quand on n'a pas mieux. */
    intensiteEstimee: integer('intensite_estimee').notNull().default(3),
    impactEstimeBp: integer('impact_estime_bp').notNull().default(10_000),
    /** Rempli apres la session, par comparaison au modele sans evenement. */
    impactMesureBp: integer('impact_mesure_bp'),
    source: text('source'),
    /**
     * Un evenement propose par Claude reste inactif tant qu'un humain ne l'a pas
     * valide : « un LLM ne calcule jamais » (CLAUDE.md §3 regle 2).
     */
    valideParHumain: integer('valide_par_humain', { mode: 'boolean' }).notNull().default(false),
    /**
     * Colonnes propres pour les propositions trouvees par l'IA (fiche 05).
     *
     * Elles etaient ENCODEES DANS `notes` par un format texte, faute de
     * colonnes. Ca fonctionnait, c'etait teste — et c'etait une dette : `notes`
     * est un champ libre que l'utilisateur peut editer, donc corrompre sans le
     * savoir ; et on ne pouvait pas filtrer les propositions par lieu en SQL.
     * Corrige avant que des donnees s'accumulent dans ce format.
     *
     * `lieuId` est NULLABLE a dessein : un evenement saisi a la main n'est pas
     * rattache a un lieu — c'est un fait du monde exterieur, pas une propriete
     * d'un marche.
     */
    lieuId: text('lieu_id').references(() => lieuMarche.id),
    /**
     * FAMILLE d'opportunite (fiche 14). Ce n'est pas un libelle : les trois
     * familles ne se PREVOIENT PAS de la meme facon.
     *
     * - `grand_public` : frequentation inconnue, tres sensible a la meteo.
     * - `entreprise` : public CAPTIF et DENOMBRABLE, creneau etroit (pause de
     *   midi), concurrence nulle, meteo bien moins determinante. Le predicteur
     *   naturel est l'EFFECTIF, pas l'historique de frequentation — le moteur
     *   actuel ne sait pas faire ca.
     * - `marche_noel` : plusieurs jours consecutifs, emplacement loue a la
     *   semaine ou au forfait.
     *
     * `NULL` = evenement-FACTEUR classique, qui module une session existante
     * sans en creer une. C'est le cas historique, et il reste majoritaire.
     */
    famille: text('famille', { enum: ['grand_public', 'entreprise', 'marche_noel'] }),
    /**
     * Effectif attendu, pour une opportunite d'entreprise. `NULL` = inconnu,
     * jamais zero — un effectif inconnu rend la prevision impossible, il ne la
     * rend pas nulle.
     */
    effectifEstime: integer('effectif_estime'),
    /** Distance A VOL D'OISEAU, en km. Ce n'est PAS une distance routiere. */
    distanceKm: integer('distance_km'),
    communeTexte: text('commune_texte'),
    /**
     * Rejet d'une proposition : on n'efface pas (CLAUDE.md §3 regle 7), on
     * marque. Une proposition rejetee reste visible et n'est jamais reproposee.
     */
    rejeteLe: text('rejete_le'),
    notes: text('notes'),
    creeLe: text('cree_le').notNull(),
    modifieLe: text('modifie_le').notNull(),
  },
  (table) => [index('idx_evenement_dates').on(table.dateDebut, table.dateFin)],
);

/**
 * Releve meteo, prevu ou reel.
 *
 * On conserve le PREVU tel qu'il etait au moment du calcul. Comparer prevu et
 * reel apres coup est la seule facon de savoir si une prevision ratee l'a ete a
 * cause du modele ou a cause de la meteo.
 */
export const meteoObservation = sqliteTable(
  'meteo_observation',
  {
    id: text('id').primaryKey(),
    lieuId: text('lieu_id')
      .notNull()
      .references(() => lieuMarche.id),
    dateObservation: text('date_observation').notNull(),
    type: text('type', { enum: ['prevision', 'reelle'] }).notNull(),
    temperatureC: real('temperature_c'),
    temperatureRessentieC: real('temperature_ressentie_c'),
    precipitationsMm: real('precipitations_mm'),
    probabilitePluieBp: integer('probabilite_pluie_bp'),
    ventKmh: real('vent_kmh'),
    couvertureNuageuseBp: integer('couverture_nuageuse_bp'),
    codeMeteo: integer('code_meteo'),
    donneesBrutes: text('donnees_brutes', { mode: 'json' }),
    recupereLe: text('recupere_le').notNull(),
    /**
     * Nombre de jours entre la RECUPERATION et la date observee.
     *
     * L'index unique portait sur (lieu, date, type) seuls : une previsions
     * recuperee a J-3 ECRASAIT donc celle de J-7. Or c'est exactement l'ECART
     * entre les deux que le predicteur meteo doit mesurer pour calibrer la
     * confiance a accorder a une prevision lointaine (fiche 07). La donnee se
     * perdait chaque semaine, sans que rien ne le signale — et docs/03 exige au
     * contraire la conservation de toutes les versions. C'est aussi la regle
     * n°7 de CLAUDE.md : rien ne s'efface.
     *
     * Vaut 0 pour `type = 'reelle'` (on observe le jour meme, par definition).
     * NULLABLE : les lignes anterieures a cette colonne ont un horizon INCONNU
     * — et « inconnu » n'est pas « zero ». Ne jamais leur en inventer un.
     */
    horizonJours: integer('horizon_jours'),
  },
  (table) => [
    // L'horizon fait partie de la cle : deux previsions du meme jour faites a
    // des echeances differentes sont deux FAITS distincts, pas une correction.
    uniqueIndex('idx_meteo_lieu_date_type_horizon').on(
      table.lieuId,
      table.dateObservation,
      table.type,
      table.horizonJours,
    ),
  ],
);

/**
 * Prevision archivee.
 *
 * Chaque prevision conserve ses ENTREES et son resultat (docs/02). C'est la
 * condition du backtesting : sans les entrees, un ecart constate n'apprend rien.
 * `crepes_reelles` et `erreur_absolue_bp` sont remplis a la cloture de la session.
 */
export const prevision = sqliteTable(
  'prevision',
  {
    id: text('id').primaryKey(),
    sessionId: text('session_id').references(() => sessionMarche.id),
    dateCalcul: text('date_calcul').notNull(),
    /** Identifie la generation d'algorithme, pour comparer des pommes et des pommes. */
    versionModele: text('version_modele').notNull(),

    baselineCrepes: integer('baseline_crepes').notNull(),
    facteurMeteoBp: integer('facteur_meteo_bp').notNull(),
    facteurEvenementBp: integer('facteur_evenement_bp').notNull(),
    facteurSaisonBp: integer('facteur_saison_bp').notNull(),
    facteurTendanceBp: integer('facteur_tendance_bp').notNull(),
    /**
     * Facteurs de precision ajoutes par la fiche 07, archives avec la prevision.
     *
     * NULLABLE et non `.default(10_000)` a dessein : `NULL` veut dire « ce
     * predicteur n'existait pas, ou n'etait pas admis, au moment de cette
     * prevision » — ce qui n'est pas la meme chose que « neutre ». Sans cette
     * distinction, l'ecran Qualite du modele ne pourrait pas dire si un facteur
     * a ete calcule et juge neutre, ou simplement pas calcule.
     *
     * Rappel : un predicteur n'entre en jeu qu'apres validation croisee
     * leave-one-out ; il reste donc souvent `NULL` les premiers mois.
     */
    facteurComparableCalendaireBp: integer('facteur_comparable_calendaire_bp'),
    facteurJourSemaineBp: integer('facteur_jour_semaine_bp'),
    facteurVacancesScolairesBp: integer('facteur_vacances_scolaires_bp'),
    facteurSessionConsecutiveBp: integer('facteur_session_consecutive_bp'),
    /** Inflation de l'ecart-type due a l'incertitude meteo. Jamais une contraction. */
    inflationSigmaMeteoBp: integer('inflation_sigma_meteo_bp'),

    p10Crepes: integer('p10_crepes').notNull(),
    p50Crepes: integer('p50_crepes').notNull(),
    p90Crepes: integer('p90_crepes').notNull(),

    quantileCibleBp: integer('quantile_cible_bp').notNull(),
    crepesRecommandees: integer('crepes_recommandees').notNull(),
    /** Apres ecretage par les contraintes dures. */
    crepesRetenues: integer('crepes_retenues').notNull(),
    contrainteLimitante: text('contrainte_limitante'),
    manqueAGagnerCents: integer('manque_a_gagner_cents'),

    repartitionRecettes: text('repartition_recettes', { mode: 'json' }),
    confianceBp: integer('confiance_bp').notNull(),
    nbSessionsComparables: integer('nb_sessions_comparables').notNull(),

    /** Commentaire Claude. Jamais un chiffre : uniquement du texte. */
    commentaireIa: text('commentaire_ia'),
    explicationFacteurs: text('explication_facteurs', { mode: 'json' }),

    crepesReelles: integer('crepes_reelles'),
    /** Erreur absolue en points de base du realise. Rempli a la cloture. */
    erreurAbsolueBp: integer('erreur_absolue_bp'),
  },
  (table) => [
    index('idx_prevision_session').on(table.sessionId),
    index('idx_prevision_date').on(table.dateCalcul),
  ],
);

/* ═══════════════════════════════════════════════════════════════════════════
   LOT 7 — Reapprovisionnement, commandes et factures fournisseur
   ═══════════════════════════════════════════════════════════════════════════ */

export const commandeFournisseur = sqliteTable(
  'commande_fournisseur',
  {
    id: text('id').primaryKey(),
